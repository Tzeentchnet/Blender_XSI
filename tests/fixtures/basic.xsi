SI_MaterialLibrary MATLIB-Example {
    1;
    XSI_Material DefaultLib.Red {
        XSI_Shader Phong {
            "Softimage.material-phong.1.0";
            "diffuse.red"; "FLOAT"; 0.8;
            "diffuse.green"; "FLOAT"; 0.1;
            "diffuse.blue"; "FLOAT"; 0.05;
            "diffuse.alpha"; "FLOAT"; 1.0;
            "specular.red"; "FLOAT"; 1.0;
            "specular.green"; "FLOAT"; 1.0;
            "specular.blue"; "FLOAT"; 1.0;
            "shiny"; "FLOAT"; 32.0;
        }
        XSI_Shader Image {
            "Softimage.txt2d-image-explicit.1.0";
            "tex"; "checker_image"; "IMAGE";
        }
    }
}

SI_Model MDL-Quad {
    SI_GlobalMaterial {
        "DefaultLib.Red";
        "BRANCH";
    }
